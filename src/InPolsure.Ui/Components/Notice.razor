@* Errors use role="alert" (assertive); info and warnings use role="status" (polite) so they do not interrupt.
   The severity is also given as visually hidden text, so it is not conveyed by colour alone (WCAG 1.4.1). *@
<div class="notice @SeverityClass" role="@Role">
    <div class="notice__body">
        <span class="visually-hidden">@SeverityLabel: </span>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <strong class="notice__title">@Title</strong>
        }
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Severity; sets the ARIA role and appearance. Default: <see cref="NoticeSeverity.Info"/>.</summary>
    [Parameter]
    public NoticeSeverity Severity { get; set; } = NoticeSeverity.Info;

    /// <summary>Optional short title shown in bold before the message.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The message.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    private string Role => Severity == NoticeSeverity.Error ? "alert" : "status";

    private string SeverityClass => Severity switch
    {
        NoticeSeverity.Warning => "notice--warning",
        NoticeSeverity.Error => "notice--error",
        _ => "notice--info",
    };

    private string SeverityLabel => Severity switch
    {
        NoticeSeverity.Warning => "Warning",
        NoticeSeverity.Error => "Error",
        _ => "Information",
    };
}
