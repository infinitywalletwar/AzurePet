@inherits LayoutComponentBase
@layout MainLayout

@* Layout for pages that opt into Interactive Server (ADR-0008): the shell plus the reconnect dialog and the
   framework error bar, which only matter while a circuit exists. The layout itself renders statically. *@
@Body

<ReconnectModal />

@* Shown by blazor.web.js (CSSOM display change, allowed by the CSP) on an unhandled circuit error. *@
<div id="blazor-error-ui" role="alert" data-nosnippet>
    <span>An unexpected error has occurred.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss">Dismiss</button>
</div>
