{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Csp": {
      "ReportOnly": false
    },
    "Hsts": {
      "Enabled": true,
      "MaxAgeSeconds": 31536000,
      "IncludeSubDomains": false
    }
  },
  "Diagnostics": {
    "EnableUiProbePages": false
  }
}
